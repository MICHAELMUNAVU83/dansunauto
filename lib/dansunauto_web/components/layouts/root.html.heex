<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable] scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />

    <% site_url = Dansunauto.AppConfig.site_url() %>
    <% default_title = "Dansun Auto Care | Car Repairs & Spare Parts in Umoja, Nairobi" %>
    <% default_description =
      "Dansun Auto Care is an auto garage and spare parts shop in Umoja I, Nairobi. " <>
        "Vehicle repairs, servicing and diagnostics, plus brake pads, filters, spark plugs, " <>
        "belts, suspension parts and batteries for Toyota, Nissan, Mazda, Subaru, Honda and " <>
        "Mitsubishi. Call or WhatsApp +254 724 335924." %>
    <% description = assigns[:meta_description] || default_description %>
    <% title = assigns[:page_title] || default_title %>
    <% canonical = assigns[:canonical_url] || site_url %>
    <% og_image = site_url <> (assigns[:og_image] || "/images/dansunauto-logo.png") %>

    <%!-- Page title --%>
    <.live_title default={default_title} suffix=" | Dansun Auto Care">
      {assigns[:page_title]}
    </.live_title>

    <%!-- Primary SEO --%>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="auto garage Umoja, car repair Nairobi, spare parts Nairobi, brake pads Nairobi, oil filter, car service Umoja, vehicle diagnostics Nairobi, car battery Nairobi, Toyota Nissan Mazda Subaru Honda Mitsubishi parts"
    />
    <meta name="author" content="Dansun Auto Care" />
    <meta name="robots" content={assigns[:robots] || "index, follow"} />
    <link rel="canonical" href={canonical} />

    <%!-- Local search: the shop serves walk-in customers at one address --%>
    <meta name="geo.region" content="KE-110" />
    <meta name="geo.placename" content="Umoja I, Nairobi" />

    <%!-- Open Graph (Facebook / WhatsApp previews) --%>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dansun Auto Care" />
    <meta property="og:locale" content="en_KE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og_image} />
    <meta property="og:url" content={canonical} />

    <%!-- Twitter / X Card --%>
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og_image} />

    <%!-- Structured data: an AutoRepair business is what Google shows in the
          local pack, so address, hours and phone are all spelled out. --%>
    <script type="application/ld+json">
      <%= Phoenix.HTML.raw(Jason.encode!(%{
        "@context" => "https://schema.org",
        "@type" => "AutoRepair",
        "name" => "Dansun Auto Care",
        "alternateName" => "Dansun Auto Garage & Spare Shop",
        "description" => default_description,
        "url" => site_url,
        "image" => og_image,
        "logo" => og_image,
        "telephone" => "+254724335924",
        "priceRange" => "KES",
        "address" => %{
          "@type" => "PostalAddress",
          "streetAddress" => "Umoja I",
          "addressLocality" => "Nairobi",
          "addressRegion" => "Nairobi",
          "addressCountry" => "KE"
        },
        "areaServed" => %{"@type" => "City", "name" => "Nairobi"},
        "openingHoursSpecification" => [
          %{
            "@type" => "OpeningHoursSpecification",
            "dayOfWeek" => ~w(Monday Tuesday Wednesday Thursday Friday Saturday),
            "opens" => "08:00",
            "closes" => "18:00"
          }
        ],
        "makesOffer" => Enum.map(
          ["Vehicle repairs", "Vehicle servicing", "Vehicle diagnostics", "Spare parts"],
          &%{"@type" => "Offer", "itemOffered" => %{"@type" => "Service", "name" => &1}}
        )
      })) %>
    </script>

    <%!-- Favicon --%>
    <link rel="icon" type="image/png" href="/images/dansunauto-logo.png" />
    <link rel="apple-touch-icon" href="/images/dansunauto-logo.png" />

    <%!-- Fonts & Styles --%>
    <% settings = Dansunauto.SiteSettings.get() %>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href={Dansunauto.SiteSettings.google_fonts_url([settings.font_body, settings.font_heading, settings.font_script])}
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <script defer src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js">
    </script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
    <%!-- Dynamic brand CSS variables — overrides defaults in app.css --%>
    <style>
      :root {
        --brand-primary:      <%= settings.primary_color %>;
        --brand-primary-dark: color-mix(in srgb, <%= settings.primary_color %> 75%, black);
        --font-heading: "<%= settings.font_heading %>", Georgia, serif;
        --font-body:    "<%= settings.font_body %>", ui-sans-serif, system-ui, sans-serif;
        --font-script:  "<%= settings.font_script %>", cursive;
      }
      /* Apply brand fonts */
      body { font-family: var(--font-body); }
      h1, h2, h3, h4, h5 { font-family: var(--font-heading); }
      .font-script, .brand-script { font-family: var(--font-script) !important; }
      /* Override all hardcoded Tailwind brand-color classes */
      .bg-\[\#C8001F\]            { background-color: var(--brand-primary) !important; }
      .text-\[\#C8001F\]          { color: var(--brand-primary) !important; }
      .border-\[\#C8001F\]        { border-color: var(--brand-primary) !important; }
      .ring-\[\#C8001F\]          { --tw-ring-color: var(--brand-primary) !important; }
      .from-\[\#C8001F\]          { --tw-gradient-from: var(--brand-primary) !important; }
      .to-\[\#C8001F\]            { --tw-gradient-to: var(--brand-primary) !important; }
      .hover\:bg-\[\#C8001F\]:hover    { background-color: var(--brand-primary) !important; }
      .hover\:text-\[\#C8001F\]:hover  { color: var(--brand-primary) !important; }
      .hover\:border-\[\#C8001F\]:hover { border-color: var(--brand-primary) !important; }
      .focus\:border-\[\#C8001F\]\/60:focus { border-color: color-mix(in srgb, var(--brand-primary) 60%, transparent) !important; }
      .focus\:ring-\[\#C8001F\]\/30:focus { --tw-ring-color: color-mix(in srgb, var(--brand-primary) 30%, transparent) !important; }
      /* Opacity variants */
      .bg-\[\#C8001F\]\/3  { background-color: color-mix(in srgb, var(--brand-primary)  3%, transparent) !important; }
      .bg-\[\#C8001F\]\/5  { background-color: color-mix(in srgb, var(--brand-primary)  5%, transparent) !important; }
      .bg-\[\#C8001F\]\/10 { background-color: color-mix(in srgb, var(--brand-primary) 10%, transparent) !important; }
      .bg-\[\#C8001F\]\/20 { background-color: color-mix(in srgb, var(--brand-primary) 20%, transparent) !important; }
      .text-\[\#C8001F\]\/40 { color: color-mix(in srgb, var(--brand-primary) 40%, transparent) !important; }
      .text-\[\#C8001F\]\/50 { color: color-mix(in srgb, var(--brand-primary) 50%, transparent) !important; }
      .text-\[\#C8001F\]\/70 { color: color-mix(in srgb, var(--brand-primary) 70%, transparent) !important; }
      .border-\[\#C8001F\]\/30 { border-color: color-mix(in srgb, var(--brand-primary) 30%, transparent) !important; }
      .border-\[\#C8001F\]\/40 { border-color: color-mix(in srgb, var(--brand-primary) 40%, transparent) !important; }
      .shadow-\[\#C8001F\]\/10 { --tw-shadow-color: color-mix(in srgb, var(--brand-primary) 10%, transparent) !important; }
      .hover\:shadow-\[\#C8001F\]\/10:hover { --tw-shadow-color: color-mix(in srgb, var(--brand-primary) 10%, transparent) !important; }
      .hover\:bg-\[\#C8001F\]\/5:hover { background-color: color-mix(in srgb, var(--brand-primary) 5%, transparent) !important; }
      .hover\:border-\[\#C8001F\]:hover { border-color: var(--brand-primary) !important; }
      .group:hover .group-hover\:text-\[\#C8001F\] { color: var(--brand-primary) !important; }
      .group:hover .group-hover\:border-\[\#C8001F\] { border-color: var(--brand-primary) !important; }
      /* Hover/focus dark states — were hardcoded as red-800 */
      .hover\:bg-red-800:hover { background-color: var(--brand-primary-dark) !important; }
      .bg-red-800 { background-color: var(--brand-primary-dark) !important; }
    </style>
  </head>
  <body class="bg-white">
    {@inner_content}
  </body>
</html>
